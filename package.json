{
  "name": "@shoujiki-panman/session-relay",
  "version": "0.2.4",
  "type": "module",
  "description": "引き継ぎ書を書かずに、AIコーディングのセッションを別ハーネスへ持ち運ぶ",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "lint": "eslint src test",
    "typecheck": "tsc --noEmit",
    "check": "npm run lint && npm run typecheck && npm run test",
    "prepublishOnly": "npm run check && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.3.0",
    "eslint": "^10.9.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "jose": "^6.2.10",
    "zod": "^4.4.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shoujiki-panman/session-relay.git"
  },
  "keywords": [
    "mcp",
    "claude-code",
    "codex",
    "handoff",
    "session",
    "context"
  ],
  "bin": {
    "relay": "bin/relay.js"
  },
  "files": [
    "dist",
    "bin",
    "skills",
    "README.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  }
}
